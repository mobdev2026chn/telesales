# ========================================================
# TELESALES MONITORING BACKEND - ENVIRONMENT TEMPLATE
# ========================================================

PORT=5000
NODE_ENV=production

# --------------------------------------------------------
# DOMAIN & HOSTING CONFIGURATION
# --------------------------------------------------------
DOMAIN=telesales.askeva.io
SERVER_URL=https://telesales.askeva.io
API_BASE_URL=https://telesales.askeva.io/api

# --------------------------------------------------------
# MONGODB CONNECTION STRING
# --------------------------------------------------------
# 1. Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/telesales_db

# 2. MongoDB Atlas (Cloud Cluster):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority

# --------------------------------------------------------
# AUTHENTICATION & SECURITY
# --------------------------------------------------------
JWT_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
ADMIN_EMAIL=admin@askeva.com
ADMIN_PASSCODE=<initial admin password, min 8 chars>
CORS_ORIGIN=https://telesales.askeva.io,*

# Accept token-less requests from old app builds on sync routes (set false once all phones are updated)
LEGACY_CLIENT_GRACE=true
