MONGODB_URI=mongodb://127.0.0.1:27017/telesales_db

# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/telesales_db?retryWrites=true&w=majority

# --------------------------------------------------------
# AUTHENTICATION & SECURITY
# --------------------------------------------------------
JWT_SECRET=askeva_telesales_super_secret_jwt_key_2026
ADMIN_EMAIL=admin@askeva.com
ADMIN_PASSCODE=123456
CORS_ORIGIN=https://telesales.askeva.io,*
