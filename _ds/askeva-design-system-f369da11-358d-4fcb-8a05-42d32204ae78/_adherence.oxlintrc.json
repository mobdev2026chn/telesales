{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/cards/**",
              "components/chat/**",
              "seminar/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Playfair Display|Archivo|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Anton, Playfair Display, Archivo, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: tone, size, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|ink|lime|outline)$/]",
        "message": "<Button> tone must be one of 'green' | 'ink' | 'lime' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|sender|time|read|action|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: direction, sender, time, read, action, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:in|out)$/]",
        "message": "<ChatBubble> direction must be one of 'in' | 'out'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|tone|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: number, label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:outline|lime|green)$/]",
        "message": "<Pill> tone must be one of 'outline' | 'lime' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|green|paper)$/]",
        "message": "<SectionLabel> tone must be one of 'ink' | 'green' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|stat|caption|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: number, label, stat, caption, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|ink|green)$/]",
        "message": "<StatCard> tone must be one of 'white' | 'ink' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TemplateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|headerTone|title|body|cta|ctaTone|style|key|ref|className|style|children)$/]",
        "message": "<TemplateCard> doesn't accept that prop. Declared props: header, headerTone, title, body, cta, ctaTone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TemplateCard'] > JSXAttribute[name.name='headerTone'] > Literal[value!=/^(?:green|lime|ink)$/]",
        "message": "<TemplateCard> headerTone must be one of 'green' | 'lime' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TemplateCard'] > JSXAttribute[name.name='ctaTone'] > Literal[value!=/^(?:green|ink|outline)$/]",
        "message": "<TemplateCard> ctaTone must be one of 'green' | 'ink' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|speed|style|key|ref|className|style|children)$/]",
        "message": "<Ticker> doesn't accept that prop. Declared props: text, speed, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
