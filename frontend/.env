# The only env file for the frontend. Vite reads it for `npm run dev` and `npm run build`.

# Where the dev server proxies /api and /socket.io (dev only; ignored by the build).
# To run the portal locally against the live backend, use https://telesales.askeva.io
# VITE_BACKEND_URL=http://localhost:5000
VITE_BACKEND_URL=https://telesales.askeva.io

# API base used by the browser. Keep /api when the build is served from the backend's own
# domain (and in development, where it goes through the proxy). For a build hosted elsewhere,
# set the full URL, e.g. https://telesales.askeva.io/api
VITE_API_BASE=/api

# Optional second API base tried when the first cannot be reached
VITE_API_FALLBACK=https://telesales.askeva.io/api